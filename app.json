{
  "expo": {
    "name": "Magadeer",
    "slug": "Recipe-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MaqadeerIcon.png",
    "scheme": "magadeer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/MaqadeerIcon.png",
        "backgroundImage": "./assets/images/MaqadeerIcon.png",
        "monochromeImage": "./assets/images/MaqadeerIcon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dooom.RecipeApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/MaqadeerIcon.png",
      "bundle": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/RecipeIconNoBackground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec4c277a-797e-4681-9f53-7b6012ef347f"
      }
    }
  }
}
